[Unit]
Description=Ekran Boshqarish Telegram Boti (Screen Bot)
After=graphical-session.target network.target

[Service]
Type=simple
WorkingDirectory=%h/remote_monitoring_bot
ExecStart=%h/remote_monitoring_bot/venv/bin/python3 %h/remote_monitoring_bot/bot.py
Restart=always
RestartSec=5
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
